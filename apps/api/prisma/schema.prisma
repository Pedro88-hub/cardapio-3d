generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  logoUrl     String?
  watermark   String?
  primaryColor String    @default("#C45C26")
  categories  Category[]
  tableSessions TableSession[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  items        MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id          String           @id @default(cuid())
  categoryId  String
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  description String?
  basePrice   Decimal          @db.Decimal(10, 2)
  imageUrl    String?
  stock       Int              @default(100)
  available   Boolean          @default(true)
  sortOrder   Int              @default(0)
  /// Tags do Raio-X nutricional (hotspots 3D)
  nutritionTags Json?
  asset       MenuItemAsset?
  modifiers   ModifierGroup[]
  cartLines   TableCartLine[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
}

model MenuItemAsset {
  id              String   @id @default(cuid())
  menuItemId      String   @unique
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  glbUrl          String
  usdzUrl         String?
  scaleFactor     Float    @default(1)
  lightingPreset  String   @default("neutral")
}

enum MeshAction {
  show
  hide
}

model ModifierGroup {
  id         String           @id @default(cuid())
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean          @default(false)
  multiSelect Boolean         @default(true)
  sortOrder  Int              @default(0)
  options    ModifierOption[]

  @@index([menuItemId])
}

model ModifierOption {
  id            String        @id @default(cuid())
  groupId       String
  group         ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  priceDelta    Decimal       @db.Decimal(10, 2) @default(0)
  meshNodeName  String?
  action        MeshAction    @default(show)
  defaultOn     Boolean       @default(false)
  sortOrder     Int           @default(0)

  @@index([groupId])
}

enum TableSessionStatus {
  open
  ordered
  closed
}

enum OrderStatus {
  pending_kitchen
  preparing
  served
  cancelled
}

enum PaymentMethod {
  pix
  apple_pay
  google_pay
  card
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum SplitMode {
  none
  by_person
  by_item
}

/// Sessão da mesa — carrinho compartilhado entre quem leu o mesmo QR
model TableSession {
  id           String             @id @default(cuid())
  restaurantId String
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableNumber  String
  status       TableSessionStatus @default(open)
  splitMode    SplitMode          @default(none)
  guestCount   Int                @default(1)
  lines        TableCartLine[]
  orders       Order[]
  payments     Payment[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([restaurantId, tableNumber])
  @@index([restaurantId, tableNumber, status])
}

model TableCartLine {
  id         String       @id @default(cuid())
  sessionId  String
  session    TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem?    @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  guestId    String
  guestName  String       @default("Convidado")
  name       String
  unitPrice  Decimal      @db.Decimal(10, 2)
  quantity   Int          @default(1)
  imageUrl   String?
  modifiers  Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([sessionId])
}

model Order {
  id          String      @id @default(cuid())
  sessionId   String
  session     TableSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status      OrderStatus @default(pending_kitchen)
  /// Snapshot dos itens enviados à cozinha (PDV futuro)
  payload     Json
  note        String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sessionId])
}

model Payment {
  id        String        @id @default(cuid())
  sessionId String
  session   TableSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  status    PaymentStatus @default(pending)
  amount    Decimal       @db.Decimal(10, 2)
  /// Ex.: payload Pix (qr/copia-cola) ou id Payment Request
  meta      Json?
  guestId   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([sessionId])
}
